# --- PayPal Developer Sandbox (required for payments) ---------------------
# developer.paypal.com > Apps & Credentials > Sandbox > Create App (Merchant)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leave as sandbox. Charter is a hackathon demo; do not point it at live.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: webhook ID from the same app (Sandbox webhooks > Add webhook, URL = https://<public-host>/api/paypal/webhook,
# events: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REVERSED).
# Webhooks need a public HTTPS URL (e.g. a tunnel). Signatures are verified with PayPal's verify-webhook-signature API.
PAYPAL_WEBHOOK_ID=

# --- Anthropic (optional but recommended) ---------------------------------
# console.anthropic.com > API keys. Without it Charter uses labelled keyword heuristics.
ANTHROPIC_API_KEY=
# CHARTER_MODEL=claude-opus-5-5

# --- Security ----------------------------------------------------------------
# Encrypt the local database at rest with AES-256-GCM. Generate with: npm run gen-key
# (Keep it secret. If you lose it, the data file cannot be decrypted.)
CHARTER_DATA_KEY=
# Content-Security-Policy mode: enforce (default) or report-only
CHARTER_CSP=enforce
# Set to true only when running behind a trusted reverse proxy (enables Secure cookies/HSTS via X-Forwarded-*)
TRUST_PROXY=false

# --- App -------------------------------------------------------------------
PORT=4242
# Set to false to disable the "Reset demo data" endpoint
CHARTER_ALLOW_RESET=true
